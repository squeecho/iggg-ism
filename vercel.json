{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/api/calendar", "destination": "/api/calendar" },
    { "source": "/calendar.ics", "destination": "/api/calendar?action=ics&cal=detail" },
    { "source": "/calendar-simple.ics", "destination": "/api/calendar?action=ics&cal=simple" }
  ],
  "functions": {
    "api/calendar.js": {
      "maxDuration": 60
    }
  }
}
